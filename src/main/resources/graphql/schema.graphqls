type Query {
    transactions: [Transaction]
}

type Mutation {
    addTransaction(input: TransactionInput!): Transaction
    updateTransaction(id: ID!, input: TransactionInput!): Transaction
    deleteTransaction(id: ID!): Boolean
}

input TransactionInput {
    amount: Float!
    type: String!
    tags: String
    notes: String
}

type Transaction {
    id: ID!
    amount: Float!
    type: String!
    tags: String
    notes: String
    timestamp: String
}
